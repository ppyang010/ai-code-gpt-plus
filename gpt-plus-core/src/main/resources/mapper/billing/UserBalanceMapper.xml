<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aichat.modules.billing.mapper.UserBalanceMapper">

    <select id="selectByUserId" resultType="com.example.aichat.modules.billing.entity.UserBalanceDO">
        SELECT *
        FROM user_balance
        WHERE user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
