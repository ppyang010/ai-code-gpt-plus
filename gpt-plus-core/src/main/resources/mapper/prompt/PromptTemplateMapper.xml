<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aichat.modules.prompt.mapper.PromptTemplateMapper">

    <select id="selectByTemplateCode" resultType="com.example.aichat.modules.prompt.entity.PromptTemplateDO">
        SELECT *
        FROM prompt_template
        WHERE template_code = #{templateCode}
        LIMIT 1
    </select>

</mapper>
